// bench.blz
print("Starting Extreme Blaze Benchmark (5M Hailstone Sequences)...");

let total_steps = 0;
let n = 1;

while n <= 5000000 {
    let curr = n;
    while curr > 1 {
        if curr % 2 == 0 {
            curr = curr / 2;
        } else {
            curr = (curr * 3) + 1;
        }
        total_steps++;
    }
    n++;
}

print("Total Hailstone Steps Computed:");
print(total_steps);

